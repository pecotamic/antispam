{
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "es2022",
            "dom"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "checkJs": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": [
            "vitest/globals"
        ]
    },
    "include": [
        "resources/js/**/*.js"
    ],
    "exclude": [
        "resources/js/**/*.test.js"
    ]
}
