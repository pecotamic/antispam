# Keep development files out of the dist package.
/.github            export-ignore
/.idea              export-ignore
/bin                export-ignore
/tests              export-ignore
/tests/**           export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/phpunit.xml        export-ignore
/tsconfig.json      export-ignore
/vitest.config.ts   export-ignore

# The frontend is served from resources/js at runtime, so it stays — but its
# tests do not.
/resources/js/*.test.js export-ignore

*.js   text eol=lf
*.php  text eol=lf
